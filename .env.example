# ========================================================
# 90th Minute — Master Environment Configuration Template
# ========================================================

# --------------------------------------------------------
# 1. Client Environment (Copy to client/.env.local)
# --------------------------------------------------------
# URL where the backend Cloudflare Worker API is running
VITE_API_BASE_URL=http://localhost:8787

# --------------------------------------------------------
# 2. Worker Local Secrets (Copy to server/.dev.vars)
# --------------------------------------------------------
# Optional: MongoDB Atlas connection string for cross-session history.
# When left empty, the room operates seamlessly using SQLite Durable Object storage.
MONGODB_URI=
MONGODB_DATABASE=90th_minute

# --------------------------------------------------------
# 3. Worker Static Configuration (Referenced in wrangler.jsonc)
# --------------------------------------------------------
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# ALLOWED_ORIGIN=http://localhost:5173

